{
  "rules": {
    "clicks": {
      ".read": true,
      ".write": "auth != null && newData.isNumber()"
    },
    "users": {
      ".read": true,
      ".indexOn": ["clicks"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString()" },
        "clicks": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
